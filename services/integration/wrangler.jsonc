{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ordem-discord-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "INTEGRATION_DB",
      "database_name": "ordem-integration-db",
      "database_id": "e3731eb0-addf-451b-b8e5-5d6e75f0ccef",
      "migrations_dir": "../../drizzle-integration"
    }
  ],
  "services": [
    {
      "binding": "PORTAL",
      "service": "ordem-da-ultima-luz"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "ordem-discord-publications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ordem-discord-publications-dlq"
      }
    ]
  },
  "vars": {
    "DISCORD_APPLICATION_ID": "1540460545558323250",
    "DISCORD_PUBLIC_KEY": "9229cf843f8487436b43fdc0c11c91210d3a9a29d589463575ae2901bf94a3b4",
    "DISCORD_GUILD_ID": "1529124400694300702",
    "DEFAULT_CAMPAIGN_ID": "11111111-1111-4111-8111-111111111111",
    "SITE_URL": "https://ordem-da-ultima-luz.ordem-da-ultima-luz.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
