{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ordem-discord-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ordem-da-ultima-luz",
      "database_id": "88493218-9d07-4649-98d4-2df515c724e4",
      "migrations_dir": "../../drizzle"
    }
  ],
  "services": [
    {
      "binding": "PORTAL",
      "service": "ordem-da-ultima-luz"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "ordem-discord-publications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "ordem-discord-publications-dlq"
      }
    ]
  },
  "vars": {
    "DISCORD_APPLICATION_ID": "1540460545558323250",
    "DEFAULT_CAMPAIGN_ID": "11111111-1111-4111-8111-111111111111",
    "SITE_URL": "https://ordem-da-ultima-luz.ordem-da-ultima-luz.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
