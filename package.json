{
  "name": "ordem-da-ultima-luz",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "bundle:worker": "wrangler deploy --dry-run --outdir .wrangler/test-bundle",
    "bundle:integration": "wrangler deploy --dry-run --config services/integration/wrangler.jsonc --outdir .wrangler/integration-test-bundle",
    "bundle:foundry": "wrangler deploy --dry-run --config services/foundry/wrangler.jsonc --outdir .wrangler/foundry-test-bundle",
    "bundle:foundry:test": "esbuild ./services/foundry/src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=.wrangler/foundry-test-bundle/worker.js",
    "bundle:automation": "wrangler deploy --dry-run --config services/automation/wrangler.jsonc --outdir .wrangler/automation-test-bundle",
    "bundle:automation:test": "esbuild ./services/automation/src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=.wrangler/automation-test-bundle/worker.js",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:integration": "wrangler deploy --config services/integration/wrangler.jsonc",
    "deploy:foundry": "wrangler deploy --config services/foundry/wrangler.jsonc",
    "deploy:automation": "wrangler deploy --config services/automation/wrangler.jsonc",
    "dev:integration": "wrangler dev --config services/integration/wrangler.jsonc",
    "dev:foundry": "wrangler dev --config services/foundry/wrangler.jsonc",
    "dev:automation": "wrangler dev --config services/automation/wrangler.jsonc",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply ordem-da-ultima-luz --local",
    "db:migrate:remote": "wrangler d1 migrations apply ordem-da-ultima-luz --remote",
    "db:migrate:integration:local": "wrangler d1 migrations apply ordem-integration-db --local --config services/integration/wrangler.jsonc",
    "db:migrate:integration:remote": "wrangler d1 migrations apply ordem-integration-db --remote --config services/integration/wrangler.jsonc",
    "db:migrate:automation:local": "wrangler d1 migrations apply ordem-automation-db --local --config services/automation/wrangler.jsonc",
    "db:migrate:automation:remote": "wrangler d1 migrations apply ordem-automation-db --remote --config services/automation/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build:cloudflare && npm run bundle:worker && npm run bundle:integration && npm run bundle:foundry && npm run bundle:foundry:test && npm run bundle:automation && npm run bundle:automation:test && npm run test:unit && node --test tests/rendered-html.test.mjs tests/marco1-api.test.mjs tests/foundry-bridge.test.mjs tests/automation-worker.test.mjs",
    "test:unit": "vitest run",
    "discord:register": "node --env-file-if-exists=.env.local scripts/register-discord-commands.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate:integration": "drizzle-kit generate --config drizzle-integration.config.ts",
    "db:generate:automation": "drizzle-kit generate --config drizzle-automation.config.ts",
    "db:migrate:integration-data": "node scripts/migrate-integration-data.mjs",
    "db:migrate:integration-data:apply": "node scripts/migrate-integration-data.mjs --apply"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.3",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.11",
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "miniflare": "5.20260820.0-alpha",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
