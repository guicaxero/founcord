{
  "name": "ordem-da-ultima-luz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/portal",
    "workers/discord",
    "workers/foundry-bridge",
    "workers/automation",
    "packages/authz",
    "packages/contracts",
    "packages/database"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/portal dev",
    "dev:discord": "bun run --cwd workers/discord dev",
    "dev:foundry": "bun run --cwd workers/foundry-bridge dev",
    "dev:automation": "bun run --cwd workers/automation dev",
    "preview": "bun run --cwd apps/portal preview",
    "build": "bun run --cwd apps/portal build:cloudflare",
    "bundle": "bun run --filter '@ordem/portal' --filter '@ordem/*-worker' bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "bun run typecheck && bun run build && bun run bundle && vitest run",
    "ci": "bun run lint && bun run test",
    "deploy:portal": "bun run --cwd apps/portal deploy",
    "deploy:discord": "bun run --cwd workers/discord deploy",
    "deploy:foundry": "bun run --cwd workers/foundry-bridge deploy",
    "deploy:automation": "bun run --cwd workers/automation deploy",
    "db:generate:portal": "bun run --cwd packages/database generate:portal",
    "db:generate:integration": "bun run --cwd packages/database generate:integration",
    "db:generate:automation": "bun run --cwd packages/database generate:automation",
    "db:migrate:portal:local": "bun run --cwd apps/portal db:migrate:local",
    "db:migrate:portal:remote": "bun run --cwd apps/portal db:migrate:remote",
    "db:migrate:integration:local": "bun run --cwd workers/discord db:migrate:local",
    "db:migrate:integration:remote": "bun run --cwd workers/discord db:migrate:remote",
    "db:migrate:automation:local": "bun run --cwd workers/automation db:migrate:local",
    "db:migrate:automation:remote": "bun run --cwd workers/automation db:migrate:remote",
    "discord:register": "bun --env-file=apps/portal/.env.local scripts/register-discord-commands.ts",
    "smoke:production": "bun scripts/smoke-production.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.11",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jiti": "^2.6.1",
    "miniflare": "5.20260820.0-alpha",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "sharp"
  ]
}
