# Aplicação OAuth criada em https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Opcional localmente; em produção use a URL exata cadastrada no Discord.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Gere pelo menos 32 bytes aleatórios. Nunca reutilize o segredo de produção.
SESSION_SECRET=
# Origem canônica usada em metadados sociais durante o desenvolvimento.
SITE_URL=http://localhost:3000
# Segredo compartilhado apenas entre os Workers Portal e Integration.
INTEGRATION_SERVICE_TOKEN=
# URL pública do Worker dedicado ao Foundry Bridge.
FOUNDRY_BRIDGE_URL=https://ordem-foundry-bridge.ordem-da-ultima-luz.workers.dev

# Marco 2 — bot HTTP do Discord.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# O pareamento do Foundry é autorizado pelo portal. Não existe secret de
# bootstrap para administradores ou mestres copiarem.
